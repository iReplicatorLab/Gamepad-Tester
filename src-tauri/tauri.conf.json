{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iReplicator Gamepad Tester",
  "version": "0.3.0",
  "identifier": "com.ireplicator.gamepad-tester",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "iReplicator Gamepad Tester",
        "width": 1120,
        "height": 780,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/gamepad-service"]
  }
}
